		{"id":"b26f67f1ea4649d7","type":"file","file":"Neu.md","x":409,"y":-1275,"width":591,"height":885},
		{"id":"e550564f8bd53498","type":"text","text":"## Блок повторяемого\n\n- [ ] ==Повторение Аудирования==\n- [ ] Общаемся с ИИ в Live-режиме (промт 2)\n- [ ] Prüfung voberaiten\n- [ ] ","x":-797,"y":-1020,"width":325,"height":290,"color":"6"},
		{"id":"ee7d611cf1e79f63","type":"file","file":"_/Fortschritt.md","x":-1520,"y":-1360,"width":640,"height":1575},
		{"id":"76db0ae8778e31e0","type":"text","text":"# ПОВТОРЯЕМ ВСЁ ИЗ ПРОШЛОГО УРОКА С ПОМОЩЬ SR и других инч","x":-793,"y":440,"width":251,"height":312},
		{"id":"b4cfb9efe370393e","type":"text","text":"## Активный пассивный словарный зщапас","x":-104,"y":440,"width":304,"height":119},
		{"id":"d1ad3ad1460a8ffe","type":"text","text":"# Заметка к месяцу\n\nПРослушать разобраный подкаст","x":727,"y":444,"width":250,"height":230},
		{"id":"341fa9c9375c9f54","type":"text","text":"## Блок нового\n\n- [ ] (DW)Смотрим отрывок NW, прорешиваем задания\n- [ ] Разбираем слова и выражения, выписываем конструкции, слова\n- [ ] ==Предыдущие SR==\n- [ ] ***==Общаемся с ИИ в Live-режиме (промт 2)==***","x":-417,"y":-1360,"width":325,"height":290,"color":"1"},
		{"id":"350aa58c8d66c8dc","type":"text","text":"## Блок повторяемого\n\n- [ ] Пишем мини сочинение (промт 1)\n- [ ] Отправляем KI\n- [ ] Проверяеи\n- [ ] Сверяем финально(можно отправить KI снова)\n- [ ] Выбираем несколько предложений для SR\n- [ ] ***==Общаемся с ИИ в Live-режиме (промт 2)==***","x":-37,"y":-1020,"width":325,"height":320,"color":"6"},
		{"id":"621f679ce911c65a","type":"text","text":"## Блок нового\n\n- [ ] ==Повторяем мини сочинение (записываем на диктофон)==\n- [ ] Аудирование [[_Metodik Hören|DLDH]]\n- [ ] Выбираем несколько предложений для SR\n- [ ] ==Предыдущие SR==\n","x":-417,"y":-680,"width":325,"height":290,"color":"1"},
		{"id":"aa1b6a25cbbeaf68","type":"text","text":"## Verbvalenz\nvv_ - verbvalenz\nvv_ref - reflexive\nvv_ref_dat - reflexive (только с Dativ, без предлога)\n\n`vv_vk_[präposition/declination]` - если предлог используется только для конкретного падежа, то указывается предлог. Также этот формат используется для случая, когда предлога в управлении нет и нужен только падеж.\n\n`vv_vk_[präposition]_[declination]` - когда предлог может использоваться и с Dativ и с Akkusativ\n","x":1040,"y":444,"width":304,"height":520},
		{"id":"e346457c49816176","type":"text","text":"# DeOn / DW Nicos Weg","x":-797,"y":-142,"width":480,"height":50},
		{"id":"86b0eaa4e7a2af43","type":"text","text":"Тема: Blue Topaz\n\n`Обозначения:\n\n*nicht wichtig*\n**Kojuktionen**\n*==Verbvalenz==*\n***==wichtig Wörter==***\n==andere==\n**==Komplement eines transitiven Verbs==**\n***Sprachkontruktionen***\n\n","x":-500,"y":440,"width":366,"height":340},
		{"id":"a53cb43d09c4491c","type":"text","text":"==Нужно прийти к принципу - накопилась пачка из 10 - повторяем==\n\nЗа день набирается пачка, желательно в тот же день повторяется и еще на следующий","x":-793,"y":840,"width":353,"height":221},
		{"id":"eff188a2af1e0a8f","type":"text","text":"Проработка типа ВОПРО - ОТВЕТ\n- стараться отвечать, формируя ответ из вопроса","x":-382,"y":840,"width":250,"height":174},
		{"id":"418fe07177792819","type":"text","text":"# Заметка: прослушивать текст перед уроком на схожую тему и краткий разбор\n","x":222,"y":440,"width":456,"height":170},
		{"id":"57dbf4930161793c","type":"text","text":"# KI Sprechen","x":-797,"y":-237,"width":250,"height":60},
		{"id":"18797ab34efd32c7","type":"text","text":"\n```mermaid\npie title Unterricht\n    \"Lesen (Podcasts)\" : 15\n    \"DLDH Hören\" : 15\n    \"Obsidian\" : 15\n    \"Aufgabe KI\" : 15\n    \"DeOn Kurs mit Gruppe\" : 30\n    \"DeOn Selbst\" : 30\n    \"DW Nicos Wg\" : 15\n    \"Goethe Z.\" : 15\n```\n","x":659,"y":-280,"width":738,"height":583},
		{"id":"3e919c6feb42d24d","type":"text","text":"с KI прорабатывем их в форме диалога","x":161,"y":-202,"width":250,"height":60},
		{"id":"be402e3753c8fa4e","type":"text","text":"### Слова/конструкции на изучение","x":-277,"y":5,"width":382,"height":87},
		{"id":"bc84b723013e9567","type":"text","text":"# Аудирование DLDH\n* повторяем предыдущий отрывок","x":-797,"y":49,"width":476,"height":138},
